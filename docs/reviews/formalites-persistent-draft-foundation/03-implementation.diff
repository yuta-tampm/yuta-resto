+    check(
+      'formalites_personnel_drafts_formality_type_check',
+      sql`${table.formalityType} = 'cdi_preparation'`,
+    ),
+    check(
+      'formalites_personnel_drafts_revision_check',
+      sql`${table.revision} > 0`,
+    ),
+    check(
+      'formalites_personnel_drafts_source_revision_check',
