+          });
+          expect(entered).toBe(false);
+        });
+        expect(await evidenceSnapshot()).toEqual(before);
+        await repository.withDossierTransaction(scope, async () => undefined);
+      } finally {
+        await pending?.catch(() => undefined);
+        await observer.end();
+      }
+    },
