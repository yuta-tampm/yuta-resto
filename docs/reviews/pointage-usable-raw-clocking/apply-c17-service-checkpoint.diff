+    expect(
+      requirePointageTestConfiguration(configuration, sampleUrl).name,
+    ).toBe('yuta_pointage_raw_clocking_test_guard');
+    for (const name of [
+      'yuta_cloud',
+      'yuta_resto',
+      'yuta_pointage_raw_clocking_test_',
