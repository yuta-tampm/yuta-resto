+      googleRetrievalMessage({
+        ...summary,
+        state: 'failed',
+        lastError: 'NOT_FOUND',
+      }),
+    ).not.toContain('supprimé');
+  });
+
+  it('shows absent content and STAFF handoff instead of an empty customer review', () => {
