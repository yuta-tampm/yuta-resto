CLOUD_DATABASE_URL=postgres://yuta_cloud:yuta_cloud@localhost:55431/yuta_cloud
CLOUD_DATABASE_SSL=false
AUTH_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_APP_URL=http://localhost:3001
GOOGLE_BUSINESS_PROFILE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_BUSINESS_PROFILE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_BUSINESS_PROFILE_REDIRECT_URI=http://localhost:3001/api/reputation/google/oauth/callback
# Generate with: openssl rand -base64 32
REPUTATION_CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
# Local development only. Production personnel-document providers are not approved.
PERSONNEL_DOCUMENT_STORAGE_ROOT=.private/personnel-documents
# Optional absolute path. Windows development auto-discovers Microsoft Defender.
PERSONNEL_DOCUMENT_WINDOWS_DEFENDER_EXECUTABLE=
# Local synthetic contract extraction only. Production always fails closed.
# Use deterministic-synthetic for offline development or openai-synthetic for
# the explicitly approved Luna/v4 fictional-PDF flow.
YUTA_PERSONNEL_CONTRACT_EXTRACTION_MODE=deterministic-synthetic
YUTA_OPENAI_EVALUATION_API_KEY=
# Explicit opt-in for the development-only Formalités read prototype.
# Production remains disabled even when this value is true.
BACKOFFICE_PERSONNEL_FORMALITES_READ_PROTOTYPE_ENABLED=false
